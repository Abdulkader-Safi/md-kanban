{
  "name": "md-kanban",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "out/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "ELECTRON_RENDERER_URL=http://localhost:5173 concurrently -k \"vite\" \"electron .\"",
    "electron:build": "npm run build && vite build -c electron/vite.main.config.ts",
    "dist": "npm run electron:build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac"
  },
  "build": {
    "appId": "com.safi.mdkanban",
    "productName": "MD Kanban",
    "files": ["out/**/*", "dist/**/*", "package.json"],
    "directories": { "output": "release" },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@tabler/icons-vue": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "marked": "^18.0.11",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
